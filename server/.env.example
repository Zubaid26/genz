# Gen-Z Threads — SERVER environment template
# Copy to .env and fill in real values:  cp .env.example .env

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/genz-threads?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string, unique per environment
JWT_SECRET=replace_with_a_long_random_string

# "development" or "production". Controls the `secure` flag on auth cookies.
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173

# Payment gateways. Leave a value blank or ending in "_here" to keep sandbox
# mode active (simulated charges, no merchant account needed).
JAZZCASH_MERCHANT_ID=your_jazzcash_merchant_id_here
JAZZCASH_PASSWORD=your_jazzcash_password_here
JAZZCASH_INTEGRITY_SALT=your_jazzcash_integrity_salt_here
JAZZCASH_RETURN_URL=http://localhost:5173/order-confirmation
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/Payment/DoMWalletTransaction

EASYPAISA_STORE_ID=your_easypaisa_store_id_here
EASYPAISA_HASH_KEY=your_easypaisa_hash_key_here
EASYPAISA_RETURN_URL=http://localhost:5173/order-confirmation
EASYPAISA_BASE_URL=https://easypay.easypaisa.com.pk/easypay-service/rest/v4/initiate-ma-transaction

# Virtual Try-On service base URL (defaults to http://localhost:8000)
TRYON_API_URL=http://localhost:8000

# ── Not yet used by any code — placeholders for planned features ──
# SMTP_HOST=smtp.gmail.com                 # order + password-reset email
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CLOUDINARY_CLOUD_NAME=                   # product image uploads
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
